---
// Portada (Main.dc.html): banda de basalto con el mapa provincial por horas, el tiempo de ahora en la capital,
// la tabla "Hoy en la provincia" y "Tus municipios".
import Base from "../layouts/Base.astro";
import Buscador from "../components/Buscador";
import MapaProvincia, { capaPorDefecto, elegirDestacados, redondearCapa } from "../components/MapaProvincia";
import TusMunicipios from "../components/TusMunicipios";
import ResumenComarcas from "../components/ResumenComarcas.astro";
import IconoCielo from "../components/IconoCielo";
import { getMeta } from "../lib/datos";
import { fichas, sinAemet } from "../lib/resumen";
import { fmt, rumbo, ZONA } from "../lib/tiempo";
import { fmtAltitud } from "../components/mapa/escalas";

const base = import.meta.env.BASE_URL;
const meta = getMeta();
const todas = fichas();
const capital = todas.find((f) => f.municipio.id === "04013") ?? todas[0];

// Mapa: capa por defecto (lluvia si llueve en algún municipio en las próximas 48 h; si no, rachas) y la lista
// lateral de la primera hora, para que se vea antes de cargar el JSON y coincida con él.
const llueve = todas.some((f) => f.prevision.horas.some((h) => (h.precip ?? 0) >= 0.1));
const capaInicial = capaPorDefecto(llueve);
const horaInicial = todas.find((f) => f.prevision.horas.length)?.prevision.horas[0]?.t;
const destacadosIniciales = elegirDestacados(
  capaInicial,
  todas.map(({ municipio: m, prevision: p }) => ({
    slug: m.slug,
    nombre: m.nombre,
    valor: redondearCapa(capaInicial, p.horas.find((h) => h.t === horaInicial)?.[capaInicial]),
  }))
);

// Ahora en Almería capital
const ahora = capital.prevision.actual;
const hoy = capital.prevision.dias[0];
const horaAhora = ahora?.t.slice(11, 16) ?? "";

// Hoy en la provincia: los municipios más poblados y uno de sierra
const DESTACADOS = ["almeria", "roquetas-de-mar", "el-ejido", "nijar", "mojacar", "albox", "velez-blanco"];
const filas = DESTACADOS.map((s) => todas.find((f) => f.municipio.slug === s)).filter((f) => f != null);

// "Predicción AEMET elaborada hoy a las 14:17" (elaborado está en UTC sin Z)
const diaMadrid = (d: Date) => d.toLocaleDateString("en-CA", { timeZone: ZONA });
function textoElaborado(elaborado: string | null): string | null {
  const ms = elaborado ? Date.parse(elaborado + "Z") : NaN;
  if (Number.isNaN(ms)) return null;
  const d = new Date(ms);
  const hora = d.toLocaleTimeString("es-ES", { timeZone: ZONA, hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
  const a = hora.startsWith("01:") ? "a la" : "a las";
  const cuando = diaMadrid(d) === diaMadrid(new Date()) ? "hoy" : `el ${d.toLocaleDateString("es-ES", { timeZone: ZONA, day: "numeric", month: "long" })}`;
  return `${cuando} ${a} ${hora}`;
}
const elaborado = textoElaborado(capital.prevision.elaborado);
const conAemet = filas.filter((f) => !sinAemet(f.municipio.id)).length;
const notaFuente =
  conAemet === filas.length && elaborado
    ? `Predicción AEMET elaborada ${elaborado}`
    : elaborado
      ? `Datos de Open-Meteo donde falta AEMET, cuya última predicción se elaboró ${elaborado}`
      : "Datos de Open-Meteo: la predicción de AEMET no está disponible";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "El tiempo en Almería",
  url: new URL(base, Astro.site).href,
  inLanguage: "es-ES",
  description: "Previsión meteorológica por horas para los 103 municipios de la provincia de Almería.",
};
---

<Base
  title="El tiempo en Almería por horas: previsión para los 103 municipios"
  description="Previsión del tiempo en la provincia de Almería: mapa por horas de lluvia, viento, rachas, temperatura y tormentas, y previsión por horas y a 7 días para sus 103 municipios, con datos de AEMET y Open-Meteo."
  jsonLd={jsonLd}
  activo="prevision"
  ancho="completo"
>
  <div slot="buscador"><Buscador client:idle base={base} version={meta.updatedAt} /></div>

  <section class="banda-oscura" aria-labelledby="mp-titulo">
    <div class="contenedor">
      <MapaProvincia
        client:visible
        base={base}
        version={meta.updatedAt}
        capaInicial={capaInicial}
        destacadosIniciales={destacadosIniciales}
        horaInicial={horaInicial}
      />
    </div>
  </section>

  <div class="contenedor pila portada">
    {
      ahora && (
        <section aria-labelledby="titulo-ahora" class="ahora">
          <div class="ahora-principal">
            <h2 id="titulo-ahora" class="ahora-titulo">
              Ahora en Almería capital, {horaAhora}
            </h2>
            <div class="ahora-cifra">
              <span class="cifra-gigante">{fmt(ahora.temp, "°")}</span>
              <div class="ahora-cielo">
                <span class="ahora-cielo-txt">
                  <IconoCielo cielo={ahora.cielo} noche={ahora.noche} size={28} />
                  {ahora.cieloTxt}
                </span>
                {hoy && (
                  <span class="texto-secundario">
                    Máxima {fmt(hoy.max, "°")}, mínima {fmt(hoy.min, "°")}
                  </span>
                )}
              </div>
            </div>
          </div>
          <dl class="datos-clave ahora-datos">
            <div>
              <dt>Viento</dt>
              <dd>{ahora.viento == null ? "—" : `${fmt(ahora.viento)} km/h ${ahora.dir == null ? "" : rumbo(ahora.dir)}`}</dd>
            </div>
            <div>
              <dt>Rachas</dt>
              <dd class="texto-almagra">{fmt(ahora.racha, " km/h")}</dd>
            </div>
            <div>
              <dt>Humedad</dt>
              <dd>{fmt(ahora.hum, " %")}</dd>
            </div>
            <div>
              <dt>Lluvia hoy</dt>
              <dd class="texto-lluvia">{fmt(hoy?.prob, " %")}</dd>
            </div>
          </dl>
          <a class="boton ahora-enlace" href={`${base}${capital.municipio.slug}/`}>Ver {capital.municipio.nombre} hora a hora</a>
        </section>
      )
    }

    <section aria-labelledby="titulo-provincia">
      <div class="provincia-cabecera">
        <h2 id="titulo-provincia" class="titular titular-2">Hoy en la provincia</h2>
        <p class="nota">{notaFuente}</p>
      </div>
      <div class="tabla-desplazable">
        <table class="tabla tabla-provincia">
          <thead>
            <tr>
              <th scope="col">Municipio</th>
              <th scope="col">Altitud</th>
              <th scope="col">Ahora</th>
              <th scope="col">Máx / mín</th>
              <th scope="col">Cielo</th>
              <th scope="col" class="num">Viento</th>
            </tr>
          </thead>
          <tbody>
            {
              filas.map(({ municipio: m, prevision: p }) => (
                <tr>
                  <th scope="row">
                    <a href={`${base}${m.slug}/`}>{m.nombre}</a>
                  </th>
                  <td class="texto-secundario">{fmtAltitud(m.altitud)}</td>
                  <td class="cifra provincia-ahora">{fmt(p.actual?.temp, "°")}</td>
                  <td>
                    {fmt(p.dias[0]?.max, "°")} / {fmt(p.dias[0]?.min, "°")}
                  </td>
                  <td>{p.actual?.cieloTxt ?? "—"}</td>
                  <td class="num">{fmt(p.actual?.viento, " km/h")}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <a class="enlace-fuerte provincia-todos" href={`${base}mapa/#municipios`}>Ver los 103 municipios</a>
    </section>

    <ResumenComarcas base={base} enlaceTodas />

    <section aria-labelledby="titulo-tus" class="panel-suave tus">
      <h2 id="titulo-tus" class="titular titular-4 tus-titulo">Tus municipios</h2>
      <TusMunicipios
        client:visible
        base={base}
        municipios={todas.map(({ municipio: m, prevision: p }) => ({ slug: m.slug, nombre: m.nombre, temp: p.actual?.temp ?? null }))}
      />
    </section>
  </div>
</Base>

<style>
  .portada {
    padding-block: 32px 24px;
  }
  @media (min-width: 48rem) {
    .portada {
      padding-block: 48px 24px;
      gap: 56px;
    }
  }

  /* Ahora en Almería capital */
  .ahora {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-linea);
  }
  .ahora-principal {
    flex: 1 1 360px;
    min-width: 0;
  }
  .ahora-titulo {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .ahora-cifra {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .ahora-cielo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 18px;
  }
  .ahora-cielo-txt {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ahora-datos {
    flex: 2 1 520px;
    margin: 0;
  }
  .ahora-datos dd {
    font-size: 28px;
  }
  .ahora-enlace {
    flex: 0 0 auto;
  }
  @media (min-width: 48rem) {
    .ahora {
      padding-bottom: 40px;
    }
    .ahora-datos {
      border-top: 0;
      padding-top: 0;
      gap: 16px;
    }
    .ahora-datos dt {
      font-size: 15px;
    }
  }

  /* Hoy en la provincia */
  .provincia-cabecera {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 12px;
    margin-bottom: 16px;
  }
  .provincia-cabecera h2,
  .provincia-cabecera p {
    margin: 0;
  }
  .tabla-provincia {
    min-width: 640px;
  }
  .tabla-provincia tbody th a {
    font-weight: 600;
    /* objetivo táctil de 44 px */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .provincia-ahora {
    font-size: 22px;
  }
  .provincia-todos {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
  }

  /* Tus municipios */
  .tus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .tus-titulo {
    margin: 0;
    flex: 0 0 auto;
  }
  .tus :global(.tus-texto) {
    margin: 0;
    flex: 1 1 300px;
  }
  .tus :global(.tus-lista) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
