                <th scope="col">Zona de aviso</th>
                <th scope="col">Costa</th>
                <th scope="col">Aviso</th>
              </tr>
            </thead>
            <tbody>
              {
                municipios.map((m) => {
                  const z = zonasAvisoDeMunicipio(m.id);
                  const na = nivelMunAhora[m.id] ?? null;
                  const nt = nivelMunTodo[m.id] ?? null;
                  return (
                    <tr>
                      <th scope="row">
                        <a href={`${base}${m.slug}/`}>{m.nombre}</a>
                      </th>
                      <td>{z.tierra?.nombre ?? "—"}</td>
                      <td>{z.costa.length ? z.costa.map((c) => nombreZona.get(c.codigo) ?? c.nombre).join("; ") : "No"}</td>
                      <td>
                        {nt ? (
                          <span class="av-celda-nivel">
                            <span class="av-punto" style={`background:${VAR_NIVEL[na ?? nt].marca};border-color:${VAR_NIVEL[na ?? nt].borde}`} aria-hidden="true" />
                            {textoNivel(na, nt)}
                          </span>
                        ) : (
                          <span class="texto-secundario">Sin aviso</span>
                        )}
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </details>
