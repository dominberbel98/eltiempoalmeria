---
// /mapa/: el mapa provincial por horas a pantalla amplia, con la misma lógica que la portada, y la lista de los 103.
import Base from "../layouts/Base.astro";
import Buscador from "../components/Buscador";
import ListaMunicipios from "../components/ListaMunicipios.astro";
import MapaProvincia, { capaPorDefecto, elegirDestacados, redondearCapa } from "../components/MapaProvincia";
import { getMeta } from "../lib/datos";
import { fichas } from "../lib/resumen";

const base = import.meta.env.BASE_URL;
const meta = getMeta();
const todas = fichas();

const llueve = todas.some((f) => f.prevision.horas.some((h) => (h.precip ?? 0) >= 0.1));
const capaInicial = capaPorDefecto(llueve);
const horaInicial = todas.find((f) => f.prevision.horas.length)?.prevision.horas[0]?.t;
const destacadosIniciales = elegirDestacados(
  capaInicial,
  todas.map(({ municipio: m, prevision: p }) => ({
    slug: m.slug,
    nombre: m.nombre,
    valor: redondearCapa(capaInicial, p.horas.find((h) => h.t === horaInicial)?.[capaInicial]),
  }))
);
---

<Base
  title="Mapa del tiempo en Almería por horas: lluvia, viento y tormentas por municipio"
  description="Mapa de la provincia de Almería con la previsión hora a hora de lluvia, probabilidad de precipitación, viento, rachas, temperatura y tormentas en cada uno de sus 103 municipios."
  activo="mapa"
  ancho="completo"
>
  <div slot="buscador"><Buscador client:idle base={base} version={meta.updatedAt} /></div>

  <section class="banda-oscura" aria-labelledby="mp-titulo">
    <div class="contenedor">
      <MapaProvincia
        client:visible
        base={base}
        version={meta.updatedAt}
        capaInicial={capaInicial}
        destacadosIniciales={destacadosIniciales}
        horaInicial={horaInicial}
        amplio
      />
    </div>
  </section>

  <div class="contenedor pila mapa-lista" id="municipios">
    <ListaMunicipios fichas={todas} titulo="Los 103 municipios" />
    <p class="nota">
      Cada área del mapa es un término municipal (límites del IGN) y su color es la previsión para el punto de referencia del
      municipio. Las flechas indican hacia dónde sopla el viento. Pulsa un municipio para ver sus zonas.
    </p>
  </div>
</Base>

<style>
  .mapa-lista {
    padding-block: 32px 24px;
  }
  @media (min-width: 48rem) {
    .mapa-lista {
      padding-block: 48px 24px;
    }
  }
</style>
