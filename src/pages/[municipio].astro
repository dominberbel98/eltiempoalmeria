---
// Página de cada municipio (Municipio.dc.html, Movil.dc.html y Zonas.dc.html).
// Dos vistas en la misma página estática: "Vista general" (por defecto y sin JavaScript) y "Por zonas"
// (solo si el municipio tiene 2 o más zonas). La vista elegida va en la URL: ?vista=zonas&zona=<id>.
import Base from "../layouts/Base.astro";
import Resumen from "../components/Resumen.astro";
import Semana from "../components/Semana.astro";
import TablaHoras from "../components/TablaHoras.astro";
import Fuentes from "../components/Fuentes.astro";
import AvisosBanda from "../components/AvisosBanda.astro";
import PlayasMunicipio from "../components/PlayasMunicipio.astro";
import Meteograma from "../components/Meteograma";
import VistaZonas from "../components/VistaZonas";
// Estilos de la vista por zonas (la isla no los importa: ver VistaZonas.tsx)
import "leaflet/dist/leaflet.css";
import "../components/mapa/mapa.css";
import Buscador from "../components/Buscador";
import { getMeta } from "../lib/datos";
import { cercanos, fichas, sinAemet, type Ficha } from "../lib/resumen";
import { aMeteograma, fmt, horaLocal } from "../lib/tiempo";
import { diferencias, getArchivoZonas, resumenDiario, tieneVistaZonas, zonasDeMunicipio } from "../lib/zonas";
import { comarcaDeMunicipio } from "../lib/comarcas";

export function getStaticPaths() {
  return fichas().map((ficha) => ({ params: { municipio: ficha.municipio.slug }, props: { ficha } }));
}

const { ficha } = Astro.props as { ficha: Ficha };
const { municipio: m, prevision: p } = ficha;
const base = import.meta.env.BASE_URL;
const meta = getMeta();
// Días desde hoy (si los datos llevan días de retraso, no se muestran días pasados)
const fechaHoy = horaLocal().slice(0, 10);
const diasDesdeHoy = p.dias.filter((d) => d.fecha >= fechaHoy);
const hoy = diasDesdeHoy[0] ?? p.dias[0];

// --- AEMET o Open-Meteo ---
const aemetHoras = p.horas.some((h) => h.aemet);
const aemetDias = p.dias.some((d) => d.aemet);
const usaAemet = aemetHoras || aemetDias;
const faltaAemet = sinAemet(m.id) || !aemetHoras;
const avisoFuente = !usaAemet
  ? `No hay predicción de AEMET al día para ${m.nombre} en esta actualización: se muestran los datos del modelo Open-Meteo.`
  : faltaAemet
    ? `La predicción por horas de AEMET para ${m.nombre} no está al día en esta actualización: las horas se muestran con el modelo Open-Meteo.`
    : null;

// --- Zonas ---
const zonas = zonasDeMunicipio(m.id);
const conZonas = tieneVistaZonas(m.id);
const archivoZonas = conZonas ? getArchivoZonas(m.id) : null;
const hayDatosZonas = archivoZonas ? resumenDiario(archivoZonas).dias.length > 0 : false;
const frases = hayDatosZonas ? diferencias(m.id) : [];
const zonaCapital = zonas.find((z) => z.tipo === "capital") ?? zonas[0];
// Miles con punto también en cifras de 4 dígitos ("1.178 m"), que toLocaleString("es-ES") deja sin separar
const metros = (n: number) => `${String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ".")} m`;
const altitudes = zonas.map((z) => z.altitud);
const altMin = altitudes.length ? Math.min(...altitudes, m.altitud) : m.altitud;
const altMax = altitudes.length ? Math.max(...altitudes, m.altitud) : m.altitud;
const rangoTermino = conZonas && altMax - altMin >= 100 ? `el término va de ${metros(altMin)} a ${metros(altMax)}` : null;
const subtitulo = `${m.id === "04013" ? "Capital de la provincia" : "Provincia de Almería"}, ${metros(m.altitud)} de altitud${rangoTermino ? `; ${rangoTermino}` : ""}`;

// --- Otros ---
const vecinos = cercanos(m, 8);
const comarca = comarcaDeMunicipio(m.id);
const tormenta = p.horas.some((h) => h.tormenta != null);

const descripcion = `Previsión del tiempo en ${m.nombre} (Almería) hora a hora: temperatura, lluvia, viento y rachas, humedad, UV y nubosidad para 48 horas y los próximos 7 días.${
  hoy ? ` Hoy, máxima de ${fmt(hoy.max, "°")} y mínima de ${fmt(hoy.min, "°")}.` : ""
}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `El tiempo en ${m.nombre} (Almería) por horas`,
  description: descripcion,
  inLanguage: "es-ES",
  dateModified: meta.updatedAt || new Date().toISOString(),
  about: {
    "@type": "Place",
    name: m.nombre,
    address: { "@type": "PostalAddress", addressLocality: m.nombre, addressRegion: "Almería", addressCountry: "ES" },
    geo: { "@type": "GeoCoordinates", latitude: m.lat, longitude: m.lon, elevation: m.altitud },
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Provincia de Almería", item: new URL(base, Astro.site).href },
      ...(comarca ? [{ "@type": "ListItem", position: 2, name: comarca.nombre, item: new URL(`${base}comarcas/${comarca.slug}/`, Astro.site).href }] : []),
      { "@type": "ListItem", position: comarca ? 3 : 2, name: m.nombre, item: new URL(`${base}${m.slug}/`, Astro.site).href },
    ],
  },
};
---

<Base title={`El tiempo en ${m.nombre} (Almería) por horas`} description={descripcion} jsonLd={jsonLd} activo="prevision">
  <div slot="buscador"><Buscador client:idle base={base} version={meta.updatedAt} /></div>
  <nav class="migas" aria-label="Migas de pan">
    <a href={base}><span class="migas-largo">Provincia de Almería</span><span class="migas-corto">Provincia</span></a> /{" "}
    {comarca && <><a href={`${base}comarcas/${comarca.slug}/`}>{comarca.nombre}</a> /{" "}</>}
    <span aria-current="page">{m.nombre}</span>
  </nav>

  <AvisosBanda municipio={m} />

  <Resumen municipio={m} prevision={p} titular subtitulo={subtitulo} />

  {
    avisoFuente && (
      <p class="aviso aviso-info" role="note" data-solo-general>
        {avisoFuente}
      </p>
    )
  }

  {
    conZonas && (
      <div class="vista-barra">
        <div class="segmentado" role="group" aria-label="Cómo ver la previsión">
          <button type="button" aria-pressed="true" data-ir-vista="general">
            Vista general
          </button>
          <button type="button" aria-pressed="false" data-ir-vista="zonas">
            Por zonas
          </button>
        </div>
        <p class="texto-secundario vista-barra-nota">
          {zonas.length} zonas del término{rangoTermino ? `, de ${metros(altMin)} a ${metros(altMax)} de altitud` : ""}
        </p>
      </div>
    )
  }

  {
    hayDatosZonas &&
      (frases.length ? (
        <section class="panel diferencias" aria-labelledby="titulo-diferencias">
          <h2 id="titulo-diferencias" class="titular titular-3 diferencias-titulo">
            Cambia mucho dentro del municipio
          </h2>
          <div class="diferencias-cuerpo">
            <ul class="diferencias-lista">
              {frases.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <button type="button" class="boton diferencias-boton" data-ir-vista="zonas" data-solo-general>
              Ver por zonas
            </button>
          </div>
        </section>
      ) : (
        <div class="panel diferencias diferencias-parecido">
          <p>El tiempo será parecido en todo el término municipal.</p>
          <button type="button" class="boton-pastilla diferencias-boton" data-ir-vista="zonas" data-solo-general>
            Ver por zonas
          </button>
        </div>
      ))
  }

  <div class="vista" data-vista="general">
    <div class="vista-horas">
      <Meteograma client:visible horas={aMeteograma(p.horas)} titulo="Las próximas horas" />
      <TablaHoras horas={p.horas} nombre={m.nombre} />
    </div>

    <Semana dias={diasDesdeHoy.length ? diasDesdeHoy : p.dias} hoy={fechaHoy} />
  </div>

  {
    conZonas && (
      <div class="vista" data-vista="zonas" hidden>
        <h2 class="sr-only">{m.nombre} por zonas</h2>
        <VistaZonas client:visible slug={m.slug} base={base} version={meta.updatedAt} nombre={m.nombre} zonaInicial={zonaCapital?.id ?? null} />
      </div>
    )
  }

  <PlayasMunicipio id={m.id} nombre={m.nombre} />

  <Fuentes
    id={m.id}
    nombre={m.nombre}
    aemet={usaAemet}
    elaborado={p.elaborado}
    tormenta={tormenta}
    zonas={conZonas && zonaCapital ? { capital: zonaCapital.nombre, cuantas: zonas.length } : null}
  />

  <section class="cerca" aria-labelledby="titulo-cerca">
    <h2 id="titulo-cerca" class="titular titular-3">Cerca de {m.nombre}</h2>
    <ul class="cerca-lista" role="list">
      {
        vecinos.map((v) => (
          <li>
            <a class="boton-pastilla" href={`${base}${v.municipio.slug}/`}>
              {v.municipio.nombre}
              {v.prevision.actual?.temp != null && (
                <span>
                  <span class="sr-only">, ahora </span>
                  {fmt(v.prevision.actual.temp, "°")}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <nav class="cerca-secciones" aria-label="Secciones">
      <a class="boton" href={`${base}mapa/`}>Mapa por horas</a>
      <a class="boton" href={`${base}radar/`}>Radar</a>
    </nav>
  </section>

  {
    conZonas && (
      <script is:inline>
        // Conmutador "Vista general" / "Por zonas". Va en línea y al final del contenido para aplicar la vista de la URL
        // antes de pintar (sin parpadeo). Sin JavaScript se ve siempre la vista general.
        (function () {
          var porVista = function (v) {
            return document.querySelectorAll(v === "general" ? '[data-vista="general"], [data-solo-general]' : '[data-vista="zonas"]');
          };
          var segmentos = document.querySelectorAll('.vista-barra [data-ir-vista]');
          var actual = null;
          var aplicar = function (v) {
            if (v === actual) return;
            actual = v;
            porVista("general").forEach(function (el) { el.hidden = v !== "general"; });
            porVista("zonas").forEach(function (el) { el.hidden = v !== "zonas"; });
            segmentos.forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute("data-ir-vista") === v)); });
            document.documentElement.setAttribute("data-vista-municipio", v);
            window.dispatchEvent(new CustomEvent("vista-municipio", { detail: { vista: v } }));
          };
          var desdeUrl = function () {
            return new URLSearchParams(location.search).get("vista") === "zonas" ? "zonas" : "general";
          };
          aplicar(desdeUrl());
          document.querySelectorAll("[data-ir-vista]").forEach(function (b) {
            b.addEventListener("click", function () {
              var v = b.getAttribute("data-ir-vista") === "zonas" ? "zonas" : "general";
              if (v !== actual) {
                var url = new URL(location.href);
                if (v === "zonas") url.searchParams.set("vista", "zonas");
                else url.searchParams.delete("vista");
                history.pushState(null, "", url);
                aplicar(v);
              }
              // Si el botón pulsado se ha ocultado ("Ver por zonas"), el foco pasa al conmutador
              if (b.hidden || b.closest("[hidden]")) {
                var destino = document.querySelector('.vista-barra [data-ir-vista="' + v + '"]');
                if (destino) {
                  destino.focus();
                  destino.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
                }
              }
            });
          });
          window.addEventListener("popstate", function () { aplicar(desdeUrl()); });
        })();
      </script>
    )
  }
</Base>

<style>
  .migas-corto {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .migas {
      font-size: 14px;
    }
    .migas-largo {
      display: none;
    }
    .migas-corto {
      display: inline;
    }
  }

  /* Conmutador de vista (solo con JavaScript) */
  .vista-barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .vista-barra-nota {
    margin: 0;
    font-size: 15px;
  }
  .vista-barra .segmentado > button {
    font-size: 16px;
    padding-inline: 20px;
  }
  :global(html:not(.js)) .vista-barra,
  :global(html:not(.js)) .diferencias-boton {
    display: none;
  }

  /* Diferencias entre zonas (Zonas.dc.html) */
  .diferencias {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    padding: 20px;
  }
  .diferencias-titulo {
    margin: 0;
    flex: 1 1 100%;
    line-height: 1.05;
  }
  .diferencias-cuerpo {
    flex: 1 1 520px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .diferencias-lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 17px;
    line-height: 1.45;
  }
  .diferencias-parecido {
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 14px;
  }
  .diferencias-parecido p {
    margin: 0;
    font-size: 17px;
  }
  @media (min-width: 48rem) {
    .diferencias {
      padding: 24px 28px;
    }
    .diferencias-titulo {
      flex: 0 0 240px;
    }
    .diferencias-lista {
      font-size: 18px;
    }
    .diferencias-parecido {
      padding-block: 16px;
    }
  }

  /* Vistas: mismas separaciones que .pagina */
  .vista {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .vista-horas {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 48rem) {
    .vista {
      gap: 48px;
    }
    .vista-horas {
      gap: 16px;
    }
  }

  /* Municipios cercanos y accesos (Movil.dc.html) */
  .cerca {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cerca h2 {
    margin: 0;
  }
  .cerca-lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cerca-lista .boton-pastilla {
    gap: 6px;
  }
  .cerca-secciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .cerca-secciones .boton {
    justify-content: flex-start;
    min-height: 56px;
    padding-inline: 16px;
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .cerca-secciones {
      display: flex;
    }
    .cerca-secciones .boton {
      min-height: 48px;
      padding-inline: 20px;
    }
  }
</style>
