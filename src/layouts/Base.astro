---
// Layout común: cabecera con navegación (y buscador opcional), aviso de datos desfasados, contenido y pie con atribuciones.
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import { getMeta } from "../lib/datos";
import { horasDesde, textoActualizacion } from "../lib/tiempo";

type Seccion =
  | "prevision"
  | "mapa"
  | "radar"
  | "avisos"
  | "playas"
  | "mar"
  | "calima"
  | "comarcas"
  | "observaciones"
  | "agro";
type Props = {
  title: string;
  description: string;
  // Datos estructurados (schema.org) de la página
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // Sección de la navegación que se marca como actual
  activo?: Seccion;
  // "contenedor" (por defecto): <main> centrado a 1280 px en columna con huecos de 48/32 px.
  // "completo": <main> sin márgenes, para páginas con bandas a todo el ancho (.banda-oscura + .contenedor).
  ancho?: "contenedor" | "completo";
  // Añade al pie la atribución de la Red de Información Agroclimática (RIA) de Andalucía
  ria?: boolean;
  // Página que no debe indexarse ni tener canonical ni og:url (la 404: GitHub Pages la sirve en cualquier ruta)
  noindex?: boolean;
};

const { title, description, jsonLd, activo, ancho = "contenedor", ria = false, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const meta = getMeta();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const conBuscador = Astro.slots.has("buscador");

type EnlaceSeccion = { id: Seccion; texto: string; href: string };
// Secciones de la cabecera. En escritorio las "principales" van en la fila y el resto en el desplegable "Más";
// en móvil (menú plegable) y sin JS se ven todas en la misma lista. El pie repite la lista completa.
const principales: EnlaceSeccion[] = [
  { id: "prevision", texto: "Previsión", href: base },
  { id: "mapa", texto: "Mapa", href: `${base}mapa/` },
  { id: "radar", texto: "Radar", href: `${base}radar/` },
  { id: "avisos", texto: "Avisos", href: `${base}avisos/` },
  { id: "playas", texto: "Playas", href: `${base}playas/` },
  { id: "mar", texto: "Mar", href: `${base}mar/` },
];
const mas: EnlaceSeccion[] = [
  { id: "calima", texto: "Calima", href: `${base}calima/` },
  { id: "comarcas", texto: "Comarcas", href: `${base}comarcas/` },
  { id: "observaciones", texto: "Observaciones", href: `${base}observaciones/` },
  { id: "agro", texto: "Agro", href: `${base}agro/` },
];
// "page" si el enlace es esta misma página; "true" si es la sección a la que pertenece (p. ej. un municipio en Previsión)
const actual = (s: EnlaceSeccion) => (s.id !== activo ? undefined : Astro.url.pathname === s.href ? "page" : "true");
const masActivo = mas.some((s) => s.id === activo);
// Con el desplegable cerrado, el aria-current de la sección no se oye: el botón dice en cuál estás
const seccionEnMas = mas.find((s) => s.id === activo)?.texto ?? null;

// Aviso si el dato más reciente tiene más de 2 h. Se calcula en el build y se repite en el navegador,
// por si la página publicada se queda sin regenerar.
const desfasado = horasDesde(meta.updatedAt) > 2;
const actualizado = meta.updatedAt ? textoActualizacion(meta.updatedAt) : null;
const jsonLdTexto = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#eef1f0" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="El tiempo en Almería" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {jsonLdTexto && <script type="application/ld+json" set:html={jsonLdTexto} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera contenedor">
      <a class="logo" href={base}>El tiempo en Almería</a>
      <div class="cabecera-botones">
        {
          conBuscador && (
            <button
              type="button"
              class="boton-icono"
              aria-label="Buscar municipio"
              aria-expanded="false"
              aria-controls="cabecera-buscador"
              data-despliega="buscador"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </button>
          )
        }
        <button type="button" class="boton-icono" aria-label="Menú" aria-expanded="false" aria-controls="menu-principal" data-despliega="menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      <nav id="menu-principal" class="nav-principal" aria-label="Principal">
        <ul class="nav-lista">
          {
            principales.map((s) => (
              <li>
                <a href={s.href} aria-current={actual(s)}>
                  {s.texto}
                </a>
              </li>
            ))
          }
          <li class="nav-mas">
            <button
              type="button"
              class:list={["nav-mas-boton", { actual: masActivo }]}
              aria-expanded="false"
              aria-controls="menu-mas"
              data-despliega="mas"
            >
              Más<span class="sr-only"> secciones{seccionEnMas && ` (estás en ${seccionEnMas})`}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="m2.5 4.5 3.5 3.5 3.5-3.5" />
              </svg>
            </button>
            <ul id="menu-mas" class="nav-mas-lista">
              {
                mas.map((s) => (
                  <li>
                    <a href={s.href} aria-current={actual(s)}>
                      {s.texto}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </nav>
      {
        conBuscador && (
          <div id="cabecera-buscador" class="cabecera-buscador">
            <slot name="buscador" />
          </div>
        )
      }
    </header>

    <section class="aviso-desfase" aria-label="Aviso sobre los datos" data-actualizado={meta.updatedAt} hidden={!desfasado}>
      <p class="contenedor">
        <strong>Los datos pueden no estar al día:</strong>{" "}
        {actualizado ? `última actualización el ${actualizado}.` : "no consta la hora de la última actualización."}
      </p>
    </section>
    <script is:inline>
      (function () {
        var aviso = document.querySelector(".aviso-desfase");
        var t = aviso ? Date.parse(aviso.getAttribute("data-actualizado") || "") : NaN;
        if (aviso && !(Date.now() - t <= 7200000)) aviso.hidden = false;
      })();
    </script>

    <main id="contenido" class={ancho === "contenedor" ? "pagina" : undefined}>
      <slot />
    </main>

    <footer class="pie contenedor">
      <div class="pie-creditos">
        <p>
          Información elaborada por la <a href="https://www.aemet.es/">Agencia Estatal de Meteorología</a>. Weather data by{" "}
          <a href="https://open-meteo.com/">Open-Meteo.com</a> (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>).
          Límites municipales y núcleos de población: obra derivada de IGR-Poblaciones 2025 y de los límites municipales del{" "}
          <a href="https://www.ign.es/">IGN</a> (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>, ign.es). Fuente:{" "}
          <a href="https://www.ine.es/">INE</a>, Nomenclátor 2025.
        </p>
        {
          ria && (
            <p>
              Datos agroclimáticos: Red de Información Agroclimática de Andalucía (RIA), IFAPA, Junta de Andalucía. Información obtenida del{" "}
              <a href="https://www.juntadeandalucia.es/agriculturaypesca/ifapa/riaweb/web/">Portal IFAPA</a>.
            </p>
          )
        }
      </div>
      <nav class="pie-secciones" aria-label="Todas las secciones">
        <ul>
          {
            [...principales, ...mas].map((s) => (
              <li>
                <a href={s.href}>{s.texto}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="pie-estado">
        <p>
          {
            actualizado ? (
              <>
                Actualizado el <time datetime={meta.updatedAt}>{actualizado}</time>
              </>
            ) : (
              "Sin hora de actualización"
            )
          }
        </p>
        <slot name="pie" />
      </div>
    </footer>

    <script>
      // Menú y buscador plegables en móvil (con JS; sin JS se muestran siempre)
      const botones = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-despliega]"));
      const panel = (b: HTMLButtonElement) => document.getElementById(b.getAttribute("aria-controls") ?? "");
      const poner = (b: HTMLButtonElement, abierto: boolean) => {
        b.setAttribute("aria-expanded", String(abierto));
        panel(b)?.classList.toggle("abierto", abierto);
      };
      for (const boton of botones) {
        boton.addEventListener("click", () => {
          const abrir = boton.getAttribute("aria-expanded") !== "true";
          for (const otro of botones) if (otro !== boton) poner(otro, false);
          poner(boton, abrir);
          if (abrir && boton.dataset.despliega === "buscador") panel(boton)?.querySelector<HTMLInputElement>("input")?.focus();
        });
      }
      // El desplegable "Más secciones" (escritorio) se cierra al pulsar fuera o al salir el foco de él
      const mas = document.querySelector<HTMLButtonElement>('[data-despliega="mas"]');
      const contenedorMas = mas?.closest(".nav-mas");
      if (mas && contenedorMas) {
        document.addEventListener("click", (e) => {
          if (mas.getAttribute("aria-expanded") === "true" && !contenedorMas.contains(e.target as Node)) poner(mas, false);
        });
        contenedorMas.addEventListener("focusout", (e) => {
          const destino = (e as FocusEvent).relatedTarget as Node | null;
          if (destino && !contenedorMas.contains(destino)) poner(mas, false);
        });
      }
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const abierto = botones.find((b) => b.getAttribute("aria-expanded") === "true");
        if (!abierto) return;
        poner(abierto, false);
        abierto.focus();
      });
    </script>
  </body>
</html>
