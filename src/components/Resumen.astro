---
// "Ahora" de un municipio: temperatura, estado del cielo y datos clave (viento, rachas, humedad, sol).
// - titular: cabecera de la página de municipio (h1 enorme, altitud y botón "Guardar en tus municipios").
// - sin titular: bloque "Ahora en {municipio}" (portada), con enlace opcional a su página.
import IconoCielo from "./IconoCielo";
import { BotonFavorito } from "./Favoritos";
import type { Municipio } from "../lib/datos";
import { fmt, rumbo, type Prevision } from "../lib/tiempo";

type Props = {
  municipio: Municipio;
  prevision: Prevision;
  titular?: boolean;
  enlace?: string;
  // Texto bajo el h1 (titular). Por defecto, la altitud.
  subtitulo?: string;
};
const { municipio: m, prevision: p, titular = false, enlace, subtitulo } = Astro.props;
const a = p.actual;
// El día de la hora "ahora" (si los datos van con retraso, p.dias[0] puede ser un día pasado)
const hoy = (a && p.dias.find((d) => d.fecha === a.t.slice(0, 10))) ?? p.dias[0];
const hora = a?.t.slice(11, 16);
const RACHA_DESTACADA = 20;
const altitud = `${String(Math.round(m.altitud)).replace(/\B(?=(\d{3})+(?!\d))/g, ".")} m de altitud`;
const sub = subtitulo ?? (m.id === "04013" ? `Capital de la provincia, ${altitud}` : `Provincia de Almería, ${altitud}`);
const viento = a?.viento != null ? `${fmt(a.viento)} km/h${a.dir != null ? ` ${rumbo(a.dir)}` : ""}` : "—";
const sol = hoy?.orto && hoy?.ocaso ? `${hoy.orto} a ${hoy.ocaso}` : "—";
const hoyTexto = hoy && (hoy.max != null || hoy.min != null) ? `Hoy, máxima ${fmt(hoy.max, "°")} y mínima ${fmt(hoy.min, "°")}.` : "";
const idTitulo = titular ? "titulo-municipio" : `titulo-ahora-${m.slug}`;
---

{
  titular ? (
    <section class="resumen" aria-labelledby={idTitulo}>
      <h1 id={idTitulo} class="titular titular-1 resumen-titulo">{m.nombre}</h1>
      <div class="resumen-pie">
        <p class="resumen-sub">{sub}</p>
        <BotonFavorito client:visible slug={m.slug} nombre={m.nombre} className="resumen-favorito" />
      </div>
      <div class="resumen-ahora" data-solo-general>
        <span class="cifra-gigante">
          <span class="sr-only">Ahora, </span>
          {fmt(a?.temp, "°")}
        </span>
        <div class="resumen-cielo">
          {a ? (
            <>
              <span class="resumen-estado">
                <IconoCielo cielo={a.cielo} noche={a.noche} size={28} />
                <span>
                  {a.cieloTxt} <span class="resumen-hora">a las {hora}</span>
                </span>
              </span>
              <span class="texto-secundario resumen-sens">Sensación de {fmt(a.sens, "°")}.</span>
              {hoyTexto && <span class="texto-secundario resumen-hoy">{hoyTexto}</span>}
            </>
          ) : (
            <span class="resumen-estado">Previsión no disponible</span>
          )}
        </div>
      </div>
      <dl class="datos-clave resumen-datos" data-solo-general>
        <div>
          <dt>Viento</dt>
          <dd>{viento}</dd>
        </div>
        <div>
          <dt>Rachas</dt>
          <dd class:list={{ "texto-almagra": (a?.racha ?? 0) > RACHA_DESTACADA }}>{a?.racha != null ? `${fmt(a.racha)} km/h` : "—"}</dd>
        </div>
        <div>
          <dt>Humedad</dt>
          <dd>{fmt(a?.hum, " %")}</dd>
        </div>
        <div>
          <dt>Sol</dt>
          <dd>{sol}</dd>
        </div>
      </dl>
    </section>
  ) : (
    <section class="resumen-portada" aria-labelledby={idTitulo}>
      <div class="resumen-portada-ahora">
        <h2 id={idTitulo} class="resumen-portada-titulo">
          Ahora en {m.nombre}
          {hora && `, ${hora}`}
        </h2>
        <div class="flex items-center gap-5">
          <span class="cifra-gigante">{fmt(a?.temp, "°")}</span>
          <div class="flex flex-col gap-1 text-lg">
            {a ? (
              <span class="flex items-center gap-2">
                <IconoCielo cielo={a.cielo} noche={a.noche} size={28} />
                {a.cieloTxt}
              </span>
            ) : (
              <span>Previsión no disponible</span>
            )}
            {hoy && (
              <span class="texto-secundario">
                Máxima {fmt(hoy.max, "°")}, mínima {fmt(hoy.min, "°")}
              </span>
            )}
          </div>
        </div>
      </div>
      <dl class="datos-clave resumen-portada-datos">
        <div>
          <dt>Viento</dt>
          <dd>{viento}</dd>
        </div>
        <div>
          <dt>Rachas</dt>
          <dd>{a?.racha != null ? `${fmt(a.racha)} km/h` : "—"}</dd>
        </div>
        <div>
          <dt>Humedad</dt>
          <dd>{fmt(a?.hum, " %")}</dd>
        </div>
        <div>
          <dt>Lluvia hoy</dt>
          <dd class="texto-lluvia">{fmt(hoy?.prob, " %")}</dd>
        </div>
      </dl>
      {
        enlace && (
          <a class="boton" href={enlace}>
            Ver {m.nombre} hora a hora
          </a>
        )
      }
    </section>
  )
}

<style>
  /* --- Cabecera del municipio. Móvil (Movil.dc.html): título, altitud, ahora, datos y botón a lo ancho --- */
  .resumen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "titulo" "sub" "ahora" "datos" "favorito";
    gap: 14px;
  }
  .resumen-titulo {
    grid-area: titulo;
    margin: 0;
  }
  /* En móvil sus hijos se colocan en la rejilla; en escritorio van juntos bajo el título */
  .resumen-pie {
    display: contents;
  }
  .resumen-sub {
    grid-area: sub;
    margin: 0;
    font-size: 16px;
  }
  .resumen-pie :global(.resumen-favorito) {
    grid-area: favorito;
    justify-content: center;
    min-height: 48px;
    border-radius: 24px;
    font-size: 16px;
  }
  .resumen-ahora {
    grid-area: ahora;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .resumen-cielo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
  }
  .resumen-estado {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }
  /* En móvil la hora y "Hoy, máxima…" se abrevian como en la maqueta */
  .resumen-hora {
    font-weight: 400;
  }
  .resumen-datos {
    grid-area: datos;
    margin: 0;
  }
  @media (max-width: 47.99rem) {
    .resumen-hora {
      display: none;
    }
  }

  /* Escritorio (Municipio.dc.html): título a la izquierda, ahora y datos a la derecha, alineados abajo */
  @media (min-width: 48rem) {
    .resumen {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "titulo ahora" "pie datos";
      gap: 16px 56px;
      align-items: end;
      margin-top: -24px;
    }
    .resumen-pie {
      grid-area: pie;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 24px;
      align-self: start;
    }
    .resumen-sub {
      font-size: 17px;
    }
    .resumen-pie :global(.resumen-favorito) {
      min-height: 44px;
      border-radius: 22px;
      font-size: 15px;
    }
    .resumen-ahora {
      gap: 24px;
    }
    .resumen-cielo {
      gap: 4px;
      font-size: 18px;
    }
    .resumen-estado {
      gap: 10px;
    }
  }
  /* Si la vista por zonas oculta "ahora" y los datos, el título ocupa todo el ancho */
  @media (min-width: 48rem) {
    .resumen:has(.resumen-ahora[hidden]) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "titulo" "pie";
    }
  }

  /* --- Bloque "Ahora en …" de la portada --- */
  .resumen-portada {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px 48px;
  }
  .resumen-portada-ahora {
    flex: 1 1 320px;
  }
  .resumen-portada-titulo {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .resumen-portada-datos {
    flex: 2 1 520px;
    margin: 0;
  }
</style>
