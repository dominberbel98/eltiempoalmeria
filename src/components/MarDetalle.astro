---
// Detalle de cada punto de la costa en /mar/: resumen por días (ola máxima, periodo, mar de fondo, viento, agua) y
// tabla cada 3 horas de las próximas 72 h con la altura de ola en barra. Es también la alternativa en tabla de las
// franjas de oleaje (MarOlaFranjas).
// Con JS se ve un punto cada vez y se elige con los botones (aria-pressed), o con un enlace a #punto-{id}; sin JS se
// ven todos seguidos y los botones no aparecen.
import MarFlecha from "./MarFlecha.astro";
import {
  colorOla,
  estadoMar,
  fmtAgua,
  fmtAltura,
  fmtPeriodo,
  fmtVientoMar,
  horaDe,
  procedencia,
  rumboCorto,
  etiquetaDia,
  type HoraMar,
  type PuntoMarPagina,
} from "../lib/mar";

type Props = { puntos: PuntoMarPagina[]; id: string };
const { puntos, id } = Astro.props;
const base = import.meta.env.BASE_URL;

// Escala común de las barras para poder comparar puntos: la ola más alta de la ventana, y al menos 1,5 m
const olaTope = Math.max(1.5, ...puntos.map((p) => p.olaMax?.valor ?? 0));
// La ola, redondeada a 1 decimal como se muestra, para que el estado y el color casen con la cifra (0,5 m es marejadilla)
const redondear = (v: number | null) => (v == null ? null : Math.round(v * 10) / 10);
const ancho = (v: number | null) => (v == null ? 0 : Math.max(2, Math.min(100, (v / olaTope) * 100)));

// Horas de la tabla: la actual y después cada 3 horas en punto (00, 03, 06…), agrupadas por día
function filasPorDia(horas: HoraMar[]) {
  const elegidas = horas.filter((h, i) => i === 0 || Number(h.t.slice(11, 13)) % 3 === 0);
  const ahoraLocal = horas[0]?.t ?? "";
  const grupos = new Map<string, HoraMar[]>();
  for (const h of elegidas) grupos.set(h.t.slice(0, 10), [...(grupos.get(h.t.slice(0, 10)) ?? []), h]);
  return [...grupos].map(([fecha, hs]) => ({ fecha, etiqueta: etiquetaDia(fecha, ahoraLocal), horas: hs }));
}
const COLUMNAS = 7;
const primero = puntos[0]?.id;
---

<div class="mar-det flex flex-col gap-5" id={id}>
  <div class="mar-det-selector chips chips-claro" role="group" aria-label="Punto de la costa" data-mar-selector>
    {
      puntos.map((p) => (
        <button type="button" aria-pressed={p.id === primero ? "true" : "false"} aria-controls={`punto-${p.id}`} data-punto={p.id}>
          {p.nombre}
        </button>
      ))
    }
  </div>

  {
    puntos.map((p) => {
      const grupos = filasPorDia(p.horas);
      return (
        <article id={`punto-${p.id}`} class:list={["mar-det-punto flex scroll-mt-4 flex-col gap-4", { activo: p.id === primero }]} data-mar-panel aria-labelledby={`t-punto-${p.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-linea pt-4">
            <h3 id={`t-punto-${p.id}`} class="titular titular-3">
              {p.nombre}
            </h3>
            <p class="nota">
              {p.municipio ? (
                <>
                  Término de <a href={`${base}${p.municipio.slug}/`}>{p.municipio.nombre}</a>
                </>
              ) : (
                "Costa de Almería"
              )}
              {p.subzona && `. En el boletín de AEMET: ${p.subzona.nombre}`}.
            </p>
          </div>

          {p.dias.length > 0 && (
            <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
              {p.dias.map((d) => {
                const c = colorOla(redondear(d.olaMax));
                return (
                  <li class="panel flex flex-col gap-2.5 p-4">
                    <h4 class="titular titular-4">
                      {d.etiqueta}
                      {d.parcial && <span class="ml-1.5 text-sm font-normal text-ceniza">({d.horas} h)</span>}
                    </h4>
                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class={`rounded-[3px] px-1.5 py-0.5 text-lg font-bold ${c?.clase ?? "bg-niebla text-basalto"} ${c?.borde ? "border border-ceniza" : ""}`}>
                        {fmtAltura(d.olaMax)}
                      </span>
                      <span>
                        {estadoMar(redondear(d.olaMax))?.nombre ?? "Sin dato"}
                        {d.olaMaxHora && <span class="text-ceniza">, a las {horaDe(d.olaMaxHora)}</span>}
                      </span>
                    </p>
                    <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[15px]">
                      <dt class="text-ceniza">Ola</dt>
                      <dd class="m-0">
                        {d.olaMin != null && d.olaMax != null ? `de ${fmtAltura(d.olaMin, false)} a ${fmtAltura(d.olaMax)}` : "—"}
                        {d.olaDir != null && `, ${procedencia(d.olaDir)}`}
                      </dd>
                      <dt class="text-ceniza">Periodo</dt>
                      <dd class="m-0">hasta {fmtPeriodo(d.periodoMax)}</dd>
                      <dt class="text-ceniza">Mar de fondo</dt>
                      <dd class="m-0">
                        hasta {fmtAltura(d.fondoMax)}
                        {d.fondoDir != null && d.fondoMax != null && `, ${procedencia(d.fondoDir)}`}
                      </dd>
                      <dt class="text-ceniza">Viento</dt>
                      <dd class="m-0">
                        hasta {fmtVientoMar(d.vientoMax)}
                        {d.vientoDir != null && `, ${procedencia(d.vientoDir)}`}
                      </dd>
                      <dt class="text-ceniza">Rachas</dt>
                      <dd class="m-0">hasta {fmtVientoMar(d.rachaMax)}</dd>
                      <dt class="text-ceniza">Agua</dt>
                      <dd class="m-0">{fmtAgua(d.aguaMedia)} de media</dd>
                    </dl>
                  </li>
                );
              })}
            </ul>
          )}

          {p.horas.length > 0 ? (
            <div class="tabla-desplazable" tabindex="0" role="region" aria-labelledby={`c-punto-${p.id}`}>
              <table class="tabla min-w-[760px] [&_td]:whitespace-nowrap [&_td]:py-2 [&_tbody_th]:py-2">
                <caption id={`c-punto-${p.id}`} class="sr-only">
                  Oleaje y viento en {p.nombre} cada 3 horas, próximas {p.horas.length} horas
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Hora</th>
                    <th scope="col" class="min-w-[17rem]">Altura de ola</th>
                    <th scope="col">Viene del</th>
                    <th scope="col" class="num">Periodo</th>
                    <th scope="col">Mar de fondo</th>
                    <th scope="col">Viento (km/h)</th>
                    <th scope="col" class="num">Racha</th>
                  </tr>
                </thead>
                {grupos.map((g) => (
                  <tbody>
                    <tr class="mar-det-dia">
                      <th colspan={COLUMNAS} scope="colgroup">
                        {g.etiqueta}
                      </th>
                    </tr>
                    {g.horas.map((h, i) => {
                      const ola = redondear(h.ola);
                      const c = colorOla(ola);
                      const e = estadoMar(ola);
                      return (
                        <tr>
                          <th scope="row" class="font-normal">
                            {g === grupos[0] && i === 0 ? "Ahora" : horaDe(h.t)}
                          </th>
                          <td>
                            {ola != null && (
                              <span class="mar-det-barra" style={`--c:${c?.fondo};--w:${ancho(ola).toFixed(1)}%`} aria-hidden="true" />
                            )}
                            <strong>{fmtAltura(ola)}</strong> {e && <span class="text-ceniza">{e.nombre.toLowerCase()}</span>}
                          </td>
                          <td>
                            <MarFlecha grados={h.olaDir} /> {rumboCorto(h.olaDir)}
                          </td>
                          <td class="num">{fmtPeriodo(h.olaPeriodo)}</td>
                          <td>{h.fondo != null && h.fondoDir != null ? `${fmtAltura(h.fondo)} del ${rumboCorto(h.fondoDir)}` : fmtAltura(h.fondo)}</td>
                          <td>
                            <MarFlecha grados={h.vientoDir} /> {fmtVientoMar(h.viento, false)}
                            {h.vientoDir != null && ` ${rumboCorto(h.vientoDir)}`}
                          </td>
                          <td class:list={["num", { "texto-almagra font-bold": (h.racha ?? 0) >= 40 }]}>{fmtVientoMar(h.racha, false)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                ))}
              </table>
            </div>
          ) : (
            <p class="aviso aviso-info">No hay previsión de oleaje para este punto.</p>
          )}
        </article>
      );
    })
  }
  <p class="nota">
    Las flechas señalan hacia dónde van la ola y el viento; la columna «Viene del» y los rumbos dicen de dónde vienen. La barra usa la misma
    escala en todos los puntos. En color almagra, rachas de 40 km/h o más.
  </p>
</div>

<style is:global>
  /* Global con prefijo mar-det-: el detalle tiene miles de celdas y un <style> con ámbito repetiría data-astro-cid en
     cada una (un 25 % del HTML de /mar/) */
  html:not(.js) .mar-det-selector {
    display: none;
  }
  html.js .mar-det-punto:not(.activo) {
    display: none;
  }
  /* Barra de la ola: pista fija con borde y el tramo coloreado hasta --w (escala común a todos los puntos) */
  .mar-det-barra {
    display: inline-block;
    width: 7rem;
    height: 12px;
    margin-right: 10px;
    border-radius: 2px;
    vertical-align: middle;
    background: linear-gradient(to right, var(--c) var(--w), transparent var(--w));
    box-shadow: inset 0 0 0 1px var(--color-linea);
  }
  @media (min-width: 48rem) {
    .mar-det-barra {
      width: 9rem;
    }
  }
  .mar-det td svg {
    vertical-align: -2px;
  }
  .mar-det-dia th {
    padding-top: 14px;
    font-weight: 700;
    background: var(--color-cal-2);
    padding-left: 8px !important;
  }
</style>

<script>
  // Selector de punto: un panel visible cada vez. El hash #punto-{id} (enlaces de la tabla de arriba) también lo cambia.
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mar-selector] [data-punto]"));
  const paneles = Array.from(document.querySelectorAll<HTMLElement>("[data-mar-panel]"));
  function elegir(id: string, desplazar: boolean) {
    const panel = paneles.find((p) => p.id === `punto-${id}`);
    if (!panel) return;
    for (const p of paneles) p.classList.toggle("activo", p === panel);
    for (const b of botones) b.setAttribute("aria-pressed", String(b.dataset.punto === id));
    if (desplazar) panel.scrollIntoView({ block: "start" });
  }
  for (const b of botones) {
    b.addEventListener("click", () => {
      const id = b.dataset.punto ?? "";
      elegir(id, false);
      history.replaceState(null, "", `#punto-${id}`);
    });
  }
  const desdeHash = () => {
    const m = /^#punto-(.+)$/.exec(location.hash);
    if (m) elegir(decodeURIComponent(m[1]), true);
  };
  window.addEventListener("hashchange", desdeHash);
  desdeHash();
</script>
