---
// "De dónde salen los datos". Con `nombre`, explica la previsión de un municipio; sin él, la de toda la web (portada).
import { getMeta } from "../lib/datos";
import { textoActualizacion } from "../lib/tiempo";

type Props = {
  id?: string;
  nombre?: string;
  // La previsión del municipio usa AEMET (si es false, todo es de Open-Meteo)
  aemet?: boolean;
  // `elaborado` de AEMET: UTC sin "Z", tal cual lo da AEMET
  elaborado?: string | null;
  // Hay alguna hora con probabilidad de tormenta de AEMET
  tormenta?: boolean;
  // El municipio tiene vista por zonas: nombre de la zona capital
  zonas?: { capital: string; cuantas: number } | null;
};
const { id, nombre, aemet, elaborado, tormenta = false, zonas = null } = Astro.props;
const meta = getMeta();
const fallos = meta.fallosAemet.length;
const conZona = (s: string) => (/[zZ]|[+-]\d\d:?\d\d$/.test(s.slice(10)) ? s : `${s}Z`);
const elaboradoTexto = elaborado ? textoActualizacion(conZona(elaborado)) : null;
const openMeteo = meta.fuentes.openMeteo?.actualizado ?? meta.updatedAt;
---

<section class="fuentes" aria-labelledby="titulo-fuentes">
  <h2 id="titulo-fuentes" class="fuentes-titulo">De dónde salen los datos</h2>
  <div class="fuentes-texto">
    {
      nombre ? (
        <>
          <p>
            {aemet
              ? `Temperatura, sensación, humedad, lluvia y estado del cielo: predicción municipal de AEMET${elaboradoTexto && elaboradoTexto !== "sin datos" ? `, elaborada el ${elaboradoTexto}` : ""}.`
              : `En esta actualización no hay predicción de AEMET al día para ${nombre}: toda la previsión de esta página es del modelo Open-Meteo.`}
            {tormenta && " La probabilidad de tormenta es de AEMET, por bloques de 6 horas."}
          </p>
          <p>
            Viento, rachas, UV y nubosidad: modelo <a href="https://open-meteo.com/">Open-Meteo</a> para las coordenadas del municipio. Son
            estimaciones de modelo, no medidas de una estación.
          </p>
          {zonas && (
            <p>
              Vista por zonas: estimación del modelo Open-Meteo en {zonas.cuantas} zonas del término, con celdas de unos 6 km y la temperatura
              corregida por altitud. Fuera de {zonas.capital}, las zonas solo tienen datos de Open-Meteo: AEMET no predice por zonas y su
              predicción oficial es para el municipio entero, la de la vista general.
            </p>
          )}
          <p class="fuentes-enlaces">
            <a href={`https://www.aemet.es/es/eltiempo/prediccion/municipios?id=${id ?? "04013"}`}>Previsión de {nombre} en aemet.es</a>
            <a href="https://www.aemet.es/es/eltiempo/prediccion/avisos">Avisos oficiales para Almería</a>
          </p>
        </>
      ) : (
        <>
          <p>
            Temperatura, humedad, lluvia y estado del cielo: predicción municipal de AEMET para los 103 municipios.
            {fallos > 0 && ` En esta actualización faltan ${fallos} municipios, que se muestran con datos del modelo Open-Meteo.`}
          </p>
          <p>
            Viento, rachas, UV y nubosidad: modelo <a href="https://open-meteo.com/">Open-Meteo</a> para las coordenadas de cada municipio.
            Última descarga: {textoActualizacion(openMeteo)}.
          </p>
          <p class="fuentes-enlaces">
            <a href="https://www.aemet.es/es/eltiempo/prediccion/avisos">Avisos oficiales para Almería</a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .fuentes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    border-top: 1px solid var(--color-linea);
    padding-top: 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-gris-texto);
  }
  .fuentes-titulo {
    margin: 0;
    flex: 0 0 200px;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-basalto);
  }
  .fuentes-texto {
    flex: 1 1 360px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 12px 48px;
  }
  .fuentes-texto p {
    margin: 0;
    max-width: 62ch;
  }
  .fuentes-enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .fuentes-enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
